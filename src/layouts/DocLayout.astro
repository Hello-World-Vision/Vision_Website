---
// =============================================================================
// DocLayout — 文章阅读布局
// 用于 docs 系列页面（/docs/algorithms/xxx、/docs/open-source/xxx）。
// 在 BaseLayout 基础上套上一层「窄栏 + 目录 + 正文排版」结构：
//   - 文章头部：标题 / 作者 / 日期 / 阅读时长 / 标签
//   - 侧边目录（TOC）：根据正文 H2~H4 生成，长文时非常有用
//   - 正文：使用 @tailwindcss/typography 的 prose 类获得优雅排版
//
// 用法：在页面里 <DocLayout ...> ... </DocLayout>，
//       页面负责 render(entry) 并传入 Content 组件、headings、frontmatter。
// =============================================================================
import BaseLayout from './BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import 'katex/dist/katex.min.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  author?: string;
  date?: Date;
  readingTime?: number;
  tags?: string[];
  collectionLabel?: string;
  /** 渲染好的正文内容（由子页面传入） */
  Content: any;
  /** 标题树，用于生成目录 */
  headings?: Heading[];
  /** 返回列表按钮链接（默认 /docs） */
  backHref?: string;
  /** 返回列表按钮文案（默认"返回全部文档"） */
  backLabel?: string;
}

const base = import.meta.env.BASE_URL;

const {
  title,
  description,
  author,
  date,
  readingTime,
  tags = [],
  collectionLabel,
  Content,
  headings = [],
  backHref = `${base}docs`,
  backLabel = '返回全部文档',
} = Astro.props;

// 取深度 2~4 的标题作为目录项
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

const formattedDate = date
  ? new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(date)
  : '';
---

<BaseLayout title={title} description={description}>
  <!-- 文章主体：左占位 + 中间正文（绝对居中）+ 右侧目录 -->
  <div class="mx-auto flex w-full max-w-[100rem] items-start justify-center gap-8 px-4 py-16 sm:px-6 md:px-8">
    <!-- 左侧批注栏 -->
    <aside class="hidden w-64 shrink-0 self-stretch lg:block">
      <div class="sticky top-24" id="annotation-sidebar">
        <div class="mb-4 flex items-center justify-between border-b border-zinc-200/60 pb-3 dark:border-zinc-800/60">
          <p class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
            </svg>
            <span class="eyebrow text-zju-400">批注</span>
          </p>
          <span id="annotation-count" class="font-mono text-xs text-zinc-500">0</span>
        </div>
        <div id="annotation-list"></div>
        <div id="annotation-empty" class="mt-6 rounded-lg border border-dashed border-zinc-300/40 p-4 text-center text-xs leading-relaxed text-zinc-400 dark:border-zinc-700/40 dark:text-zinc-500">
          <svg class="mx-auto mb-2 h-6 w-6 text-zinc-300 dark:text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          选中正文中的文字<br>即可添加批注。
        </div>
      </div>
    </aside>

    <!-- 中间正文：限定阅读宽度，绝对居中 -->
    <div class="min-w-0 w-full max-w-4xl xl:max-w-5xl 2xl:max-w-6xl">
      <article>
        <!-- ── 文章头部信息 ─────────────────────────────────── -->
        <header class="mb-10 border-b border-zinc-200 pb-8 dark:border-zinc-800">
          {collectionLabel && <p class="eyebrow mb-4 text-zju-400">{collectionLabel}</p>}
          <h1 class="text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">
            {title}
          </h1>
          <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
            {description}
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
            {author && (
              <span class="flex items-center gap-1.5">
                <Icon name="mdi:account" class="h-4 w-4 text-zju-400" />
                {author}
              </span>
            )}
            {formattedDate && (
              <time class="flex items-center gap-1.5">
                <Icon name="mdi:calendar-blank-outline" class="h-4 w-4 text-zju-400" />
                {formattedDate}
              </time>
            )}
            {readingTime && (
              <span class="flex items-center gap-1.5">
                <Icon name="mdi:clock-outline" class="h-4 w-4 text-zju-400" />
                约 {readingTime} 分钟
              </span>
            )}
          </div>

          {tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span
                  class="rounded-full border border-zinc-300 px-3 py-0.5 text-xs font-medium text-zinc-600 dark:border-zinc-700 dark:text-zinc-300"
                >
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <!-- ── 正文：prose 排版（H1~H6/Blockquote/Table/代码块全部生效）── -->
        <div class="prose prose-zinc max-w-none dark:prose-invert dark:prose-headings:text-zinc-100 prose-a:text-zju-500 dark:prose-a:text-zju-300 prose-pre:border prose-pre:border-zinc-700 prose-pre:bg-zinc-900">
          <Content />
        </div>
      </article>
    </div>

    <!-- 右侧目录（窄屏自动隐藏，sticky 随页面滚动） -->
    <aside class="hidden w-64 shrink-0 self-stretch lg:block">
      {toc.length > 0 && (
        <div class="sticky top-24 rounded-2xl border border-zinc-200 bg-white/70 p-5 dark:border-zinc-800 dark:bg-zinc-900/50 backdrop-blur">
          <p class="eyebrow mb-4 text-zju-400">目录</p>
          <nav class="space-y-2 text-sm">
            {toc.map((h) => (
              <a
                href={`#${h.slug}`}
                class:list={[
                  'block leading-snug transition-colors hover:text-zju-400',
                  h.depth === 3 ? 'pl-4' : '',
                  h.depth === 4 ? 'pl-8' : '',
                  'text-zinc-500 dark:text-zinc-400',
                ]}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      )}
    </aside>
  </div>

  <!-- 返回列表按钮 -->
  <div class="container-page pb-16">
    <a
      href={backHref}
      class="inline-flex items-center gap-2 rounded-full border border-zinc-300 px-5 py-2 text-sm font-medium transition-colors hover:border-zju-400 hover:text-zju-400 dark:border-zinc-700"
    >
      <Icon name="mdi:arrow-left" class="h-4 w-4" />
      {backLabel}
    </a>
  </div>
</BaseLayout>

<style>
  /* 锚点跳转时给吸顶 Header 让出空间 */
  article :is(h2, h3, h4) {
    scroll-margin-top: 7rem;
  }

  /* 正文图片：缩放到 60% 并居中显示。
     :global() 是因为正文由 <Content /> 渲染，元素不带本组件的 scoped 属性。 */
  :global(article .prose img) {
    max-width: 60%;
    height: auto;
    display: block;
    margin: 1.5rem auto;
  }

  /* Mermaid 图表容器 */
  .mermaid {
    margin: 1.5rem auto;
    padding: 1.5rem 1rem;
    border-radius: 0.75rem;
    background: #fff;
    overflow-x: auto;
  }
  html.dark .mermaid {
    background: #0f172a;
  }
  .mermaid svg {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  /* ── 批注系统样式 ──────────────────────────────────────────── */

  /* 批注高亮标记（dynamic 元素，需 global） */
  :global(.annotation-highlight) {
    background: rgba(56, 189, 248, 0.18);
    border-bottom: 2px solid rgba(56, 189, 248, 0.55);
    border-radius: 2px;
    cursor: help;
    padding: 0 1px;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  html.dark :global(.annotation-highlight) {
    background: rgba(56, 189, 248, 0.14);
    border-bottom-color: rgba(56, 189, 248, 0.45);
  }
  :global(.annotation-highlight.is-active) {
    background: rgba(56, 189, 248, 0.35);
    border-bottom-color: rgba(56, 189, 248, 0.9);
  }
  html.dark :global(.annotation-highlight.is-active) {
    background: rgba(56, 189, 248, 0.3);
    border-bottom-color: rgba(56, 189, 248, 0.8);
  }

  /* 批注工具栏（选中文字后弹出） */
  #annotation-toolbar {
    position: fixed;
    z-index: 50;
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(56, 189, 248, 0.3);
    background: rgba(24, 24, 27, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    transform: translate(-50%, -100%);
    font-size: 0.8125rem;
    color: #e4e4e7;
    white-space: nowrap;
  }
  html.light #annotation-toolbar {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(56, 189, 248, 0.4);
    color: #18181b;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  #annotation-toolbar button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.6rem;
    border-radius: 0.5rem;
    border: none;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: background 0.15s;
  }
  #annotation-toolbar .btn-add {
    background: rgba(56, 189, 248, 0.2);
    color: #38bdf8;
  }
  #annotation-toolbar .btn-add:hover {
    background: rgba(56, 189, 248, 0.35);
  }
  #annotation-toolbar .btn-close {
    background: transparent;
    color: #a1a1aa;
  }
  #annotation-toolbar .btn-close:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  html.light #annotation-toolbar .btn-close:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  /* 批注输入浮层 */
  #annotation-input-popup {
    position: fixed;
    z-index: 51;
    display: none;
    width: 22rem;
    max-width: calc(100vw - 2rem);
    padding: 1rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(56, 189, 248, 0.3);
    background: rgba(24, 24, 27, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
  }
  html.light #annotation-input-popup {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.15);
  }
  #annotation-input-popup .popup-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  #annotation-input-popup .popup-header span {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #38bdf8;
  }
  #annotation-input-popup .popup-header button {
    background: none;
    border: none;
    color: #a1a1aa;
    font-size: 1rem;
    cursor: pointer;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    transition: background 0.15s;
  }
  #annotation-input-popup .popup-header button:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  html.light #annotation-input-popup .popup-header button:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  #annotation-input-popup .selected-text-preview {
    margin-bottom: 0.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    font-size: 0.75rem;
    line-height: 1.5;
    color: #a1a1aa;
    max-height: 3.6rem;
    overflow-y: auto;
    word-break: break-all;
  }
  html.light #annotation-input-popup .selected-text-preview {
    background: rgba(0, 0, 0, 0.04);
    color: #52525b;
  }
  #annotation-input-popup .selected-text-preview::before {
    content: '「';
    color: #38bdf8;
  }
  #annotation-input-popup .selected-text-preview::after {
    content: '」';
    color: #38bdf8;
  }
  #annotation-input-popup textarea {
    width: 100%;
    min-height: 5rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: inherit;
    font-size: 0.875rem;
    line-height: 1.6;
    resize: vertical;
    outline: none;
    transition: border-color 0.15s;
    font-family: inherit;
  }
  html.light #annotation-input-popup textarea {
    border-color: rgba(0, 0, 0, 0.1);
    background: rgba(0, 0, 0, 0.03);
  }
  #annotation-input-popup textarea:focus {
    border-color: #38bdf8;
  }
  #annotation-input-popup .popup-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  #annotation-input-popup .popup-actions button {
    padding: 0.375rem 1rem;
    border-radius: 0.5rem;
    border: none;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: background 0.15s;
  }
  #annotation-input-popup .popup-actions .btn-cancel {
    background: transparent;
    color: #a1a1aa;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  html.light #annotation-input-popup .popup-actions .btn-cancel {
    border-color: rgba(0, 0, 0, 0.1);
  }
  #annotation-input-popup .popup-actions .btn-cancel:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  html.light #annotation-input-popup .popup-actions .btn-cancel:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  #annotation-input-popup .popup-actions .btn-save {
    background: #38bdf8;
    color: #fff;
    font-weight: 600;
  }
  #annotation-input-popup .popup-actions .btn-save:hover {
    background: #7dd3fc;
  }
  html.light #annotation-input-popup .popup-actions .btn-save:hover {
    background: #5fc9f8;
  }

  /* ── 左侧批注列表项（dynamic 元素，需 global）── */

  /* 批注列表容器 */
  :global(#annotation-list) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* 单条批注卡片 */
  :global(.annotation-item) {
    position: relative;
    padding: 0.75rem 0.75rem 0.6rem 0.875rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(56, 189, 248, 0.1);
    background: rgba(56, 189, 248, 0.03);
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease,
                box-shadow 0.25s ease;
    /* 左侧彩色竖条 */
    box-shadow: inset 3px 0 0 rgba(56, 189, 248, 0.25);
  }
  :global(.annotation-item):hover {
    background: rgba(56, 189, 248, 0.07);
    border-color: rgba(56, 189, 248, 0.25);
    box-shadow: inset 3px 0 0 rgba(56, 189, 248, 0.55),
                0 4px 16px rgba(56, 189, 248, 0.06);
  }
  html.dark :global(.annotation-item) {
    border-color: rgba(56, 189, 248, 0.08);
    background: rgba(56, 189, 248, 0.02);
    box-shadow: inset 3px 0 0 rgba(56, 189, 248, 0.2);
  }
  html.dark :global(.annotation-item):hover {
    background: rgba(56, 189, 248, 0.06);
    border-color: rgba(56, 189, 248, 0.22);
    box-shadow: inset 3px 0 0 rgba(56, 189, 248, 0.5),
                0 4px 20px rgba(0, 0, 0, 0.3);
  }

  /* 批注内容（用户写的批注文本） */
  :global(.annotation-item .annotation-note) {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.55;
    color: #e4e4e7;
    word-break: break-word;
    padding-right: 1.25rem; /* 给删除按钮留空间 */
  }
  html.light :global(.annotation-item .annotation-note) {
    color: #18181b;
  }

  /* 引用原文气泡（橙色高亮，便于从批注内容中一眼区分） */
  :global(.annotation-item .annotation-quote) {
    position: relative;
    margin-top: 0.5rem;
    padding: 0.45rem 0.6rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: #fb923c; /* orange-400 */
    background: rgba(251, 146, 60, 0.08);
    border: 1px solid rgba(251, 146, 60, 0.18);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-all;
    font-style: italic;
  }
  html.light :global(.annotation-item .annotation-quote) {
    background: rgba(251, 146, 60, 0.1);
    border-color: rgba(251, 146, 60, 0.25);
    color: #c2410c; /* orange-700 */
  }
  :global(.annotation-item .annotation-quote)::before {
    content: '“';
    color: #fb923c;
    font-style: normal;
    font-weight: 600;
    opacity: 0.9;
  }
  :global(.annotation-item .annotation-quote)::after {
    content: '”';
    color: #fb923c;
    font-style: normal;
    font-weight: 600;
    opacity: 0.9;
  }

  /* 底部信息行：时间 + 序号 */
  :global(.annotation-item .annotation-footer) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.35rem;
  }

  :global(.annotation-item .annotation-time) {
    font-size: 0.625rem;
    color: #52525b;
    font-family: 'JetBrains Mono Variable', monospace;
    letter-spacing: 0.02em;
  }
  html.light :global(.annotation-item .annotation-time) {
    color: #a1a1aa;
  }

  :global(.annotation-item .annotation-index) {
    font-size: 0.625rem;
    color: rgba(56, 189, 248, 0.3);
    font-family: 'JetBrains Mono Variable', monospace;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  html.dark :global(.annotation-item .annotation-index) {
    color: rgba(56, 189, 248, 0.25);
  }

  /* 删除按钮 */
  :global(.annotation-item .annotation-delete) {
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    opacity: 0.5;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #a1a1aa;
    font-size: 0.6875rem;
    cursor: pointer;
    border-radius: 0.375rem;
    transition: opacity 0.2s ease, background 0.15s, color 0.15s,
                border-color 0.15s;
  }
  :global(.annotation-item:hover .annotation-delete) {
    opacity: 1;
    background: rgba(248, 113, 113, 0.12);
    border-color: rgba(248, 113, 113, 0.25);
    color: #f87171;
  }
  :global(.annotation-item .annotation-delete):hover {
    opacity: 1;
    background: rgba(248, 113, 113, 0.2);
    border-color: rgba(248, 113, 113, 0.4);
    color: #fca5a5;
  }

  /* 批注出现动画 */
  :global(.annotation-item) {
    animation: annotationSlideIn 0.35s ease both;
  }
  @keyframes annotationSlideIn {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  :global(.annotation-item):nth-child(1) { animation-delay: 0s; }
  :global(.annotation-item):nth-child(2) { animation-delay: 0.03s; }
  :global(.annotation-item):nth-child(3) { animation-delay: 0.06s; }
  :global(.annotation-item):nth-child(4) { animation-delay: 0.09s; }
  :global(.annotation-item):nth-child(5) { animation-delay: 0.12s; }
</style>

<script>
  // ── Mermaid 图表渲染 ─────────────────────────────────────────
  // 把 ```mermaid 代码块渲染为图表。mermaid 按需动态加载，
  // 只有页面里真的存在 mermaid 块时才拉取，避免给所有文档页增加体积。
  (async () => {
    const pres = Array.from(
      document.querySelectorAll<HTMLPreElement>(
        'pre[data-language="mermaid"], pre code.language-mermaid'
      )
    );
    if (!pres.length) return;

    const nodes = pres.map((pre) => {
      const code = pre.querySelector('code');
      const div = document.createElement('div');
      div.className = 'mermaid';
      div.textContent = code?.textContent ?? '';
      pre.replaceWith(div);
      return div;
    });

    try {
      const { default: mermaid } = await import('mermaid');
      const isDark = document.documentElement.classList.contains('dark');
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'default',
        securityLevel: 'loose',
      });
      const results = await mermaid.run({ nodes });
      results.forEach((r, i) => {
        if (r && r.error) console.warn('Mermaid 渲染失败:', r.error);
      });
    } catch (err) {
      console.warn('Mermaid 加载失败:', err);
    }
  })();
</script>

<script>
  // ── 目录滚动监听：高亮当前浏览章节 ──────────────────────────
  const tocLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('aside nav a[href^="#"]')
  );
  const headings = Array.from(
    document.querySelectorAll<HTMLElement>('article h2, article h3, article h4')
  );

  if (tocLinks.length && headings.length) {
    const linkFor = (slug: string) =>
      tocLinks.find((a) => a.getAttribute('href') === `#${slug}`);

    const setActive = (slug: string | null) => {
      tocLinks.forEach((a) => {
        a.style.color = '';
        a.style.textShadow = '';
      });
      if (!slug) return;
      const link = linkFor(slug);
      if (link) {
        link.style.color = '#38bdf8';
        link.style.textShadow = '0 0 12px rgba(56, 189, 248, 0.7)';
      }
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]) setActive(visible[0].target.id);
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      );
      headings.forEach((h) => observer.observe(h));
    }

    // 初始高亮第一个标题
    setActive(headings[0].id);
  }
</script>

<!-- ── 批注系统 DOM ──────────────────────────────────────────────── -->
<div id="annotation-toolbar">
  <span id="toolbar-selected-preview" style="max-width:12rem;overflow:hidden;text-overflow:ellipsis;"></span>
  <span style="color:#71717a;">|</span>
  <button class="btn-add" id="annotation-add-btn">✏ 添加批注</button>
  <button class="btn-close" id="annotation-close-btn">✕</button>
</div>
<div id="annotation-input-popup">
  <div class="popup-header">
    <span>添加批注</span>
    <button id="popup-close-btn">✕</button>
  </div>
  <div class="selected-text-preview" id="popup-selected-text"></div>
  <textarea id="annotation-textarea" placeholder="输入批注内容…" rows="3"></textarea>
  <div class="popup-actions">
    <button class="btn-cancel" id="popup-cancel-btn">取消</button>
    <button class="btn-save" id="popup-save-btn">保存</button>
  </div>
</div>

<script>
  // ── 批注系统 ─────────────────────────────────────────────────
  (() => {
    // ---------- 工具函数 ----------
    const STORAGE_KEY = 'zju-annotations';
    const pageKey = location.pathname.replace(/\/$/, '') || '/';

    function loadAnnotations() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const data = raw ? JSON.parse(raw) : {};
        return data[pageKey] || [];
      } catch { return []; }
    }

    function saveAnnotations(annotations) {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const data = raw ? JSON.parse(raw) : {};
        data[pageKey] = annotations;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      } catch {}
    }

    function getAnnotations() { return loadAnnotations(); }

    function formatTime(ts) {
      const d = new Date(ts);
      const pad = (n) => String(n).padStart(2, '0');
      return `${pad(d.getMonth() + 1)}/${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }

    // ---------- DOM 引用 ----------
    const toolbar = document.getElementById('annotation-toolbar')!;
    const toolbarPreview = document.getElementById('toolbar-selected-preview')!;
    const addBtn = document.getElementById('annotation-add-btn')!;
    const closeBtn = document.getElementById('annotation-close-btn')!;
    const popup = document.getElementById('annotation-input-popup')!;
    const popupText = document.getElementById('popup-selected-text')!;
    const textarea = document.getElementById('annotation-textarea')! as HTMLTextAreaElement;
    const saveBtn = document.getElementById('popup-save-btn')!;
    const cancelBtn = document.getElementById('popup-cancel-btn')!;
    const popupCloseBtn = document.getElementById('popup-close-btn')!;
    const sidebar = document.getElementById('annotation-list')!;
    const emptyHint = document.getElementById('annotation-empty')!;
    const countEl = document.getElementById('annotation-count')!;

    let currentSelection: { text: string; range: Range; y: number } | null = null;

    // ---------- 渲染批注列表 ----------
    function renderAnnotations() {
      const annotations = getAnnotations();
      if (countEl) countEl.textContent = String(annotations.length);
      if (emptyHint) emptyHint.style.display = annotations.length === 0 ? 'block' : 'none';

      if (!sidebar) return;
      sidebar.innerHTML = '';
      annotations.forEach((ann: any, idx: number) => {
        const item = document.createElement('div');
        item.className = 'annotation-item';
        item.dataset.id = ann.id;
        item.style.animationDelay = `${idx * 0.04}s`;
        item.innerHTML = `
          <button class="annotation-delete" data-id="${ann.id}">✕</button>
          <div class="annotation-note">${escapeHtml(ann.note)}</div>
          <div class="annotation-quote">${escapeHtml(ann.text)}</div>
          <div class="annotation-footer">
            <span class="annotation-time">${formatTime(ann.createdAt)}</span>
            <span class="annotation-index">#${String(idx + 1).padStart(2, '0')}</span>
          </div>
        `;
        item.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).classList.contains('annotation-delete')) return;
          scrollToAnnotation(ann.id);
        });
        const delBtn = item.querySelector('.annotation-delete')!;
        delBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          deleteAnnotation(ann.id);
        });
        sidebar.appendChild(item);
      });
    }

    function escapeHtml(str: string) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // ---------- 高亮所有已批注文本 ----------
    function highlightAnnotations() {
      // 清除旧高亮
      document.querySelectorAll('.annotation-highlight').forEach((el) => {
        const parent = el.parentNode!;
        parent.replaceChild(document.createTextNode(el.textContent || ''), el);
        parent.normalize();
      });

      const annotations = getAnnotations();
      const article = document.querySelector('article');
      if (!article || annotations.length === 0) return;

      const bodyText = article.textContent || '';

      annotations.forEach((ann: any) => {
        const idx = bodyText.indexOf(ann.text);
        if (idx === -1) return;

        // Walk text nodes to find and wrap the target text
        const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT, null);
        let charOffset = 0;
        let node: Text | null;
        while ((node = walker.nextNode() as Text | null)) {
          const nextOffset = charOffset + (node.textContent?.length || 0);
          if (charOffset <= idx && idx < nextOffset) {
            const localStart = idx - charOffset;
            const localEnd = localStart + ann.text.length;
            // Only wrap if the entire match is within this text node
            if (localEnd <= (node.textContent?.length || 0)) {
              const span = document.createElement('span');
              span.className = 'annotation-highlight';
              span.dataset.annotationId = ann.id;
              span.textContent = node.textContent!.slice(localStart, localEnd);
              const rest = node.textContent!.slice(localEnd);
              node.textContent = node.textContent!.slice(0, localStart);
              node.parentNode!.insertBefore(span, node.nextSibling);
              if (rest) {
                node.parentNode!.insertBefore(document.createTextNode(rest), span.nextSibling);
              }
            }
            break;
          }
          charOffset = nextOffset;
        }
      });
    }

    // ---------- 滚动到某条批注 ----------
    function scrollToAnnotation(id: string) {
      const el = document.querySelector(`.annotation-highlight[data-annotation-id="${id}"]`);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.classList.add('is-active');
        setTimeout(() => el.classList.remove('is-active'), 2000);
      }
    }

    // ---------- 删除批注 ----------
    function deleteAnnotation(id: string) {
      let annotations = getAnnotations();
      annotations = annotations.filter((a: any) => a.id !== id);
      saveAnnotations(annotations);
      renderAnnotations();
      highlightAnnotations();
    }

    // ---------- 工具栏 ----------
    function showToolbar(x: number, y: number, text: string) {
      toolbarPreview.textContent = text.length > 50 ? text.slice(0, 50) + '…' : text;
      let top = y - 12;
      let left = x;
      // Keep within viewport
      const tw = toolbar.offsetWidth;
      if (left + tw / 2 > window.innerWidth - 16) left = window.innerWidth - 16 - tw / 2;
      if (left - tw / 2 < 16) left = 16 + tw / 2;
      if (top < 16) top = 16;
      toolbar.style.top = top + 'px';
      toolbar.style.left = left + 'px';
      toolbar.style.display = 'flex';
    }

    function hideToolbar() {
      toolbar.style.display = 'none';
    }

    // ---------- 输入浮层 ----------
    function showPopup(text: string, x: number, y: number) {
      popupText.textContent = text;
      textarea.value = '';
      textarea.focus();
      // Position popup below toolbar area
      let top = y + 20;
      let left = x;
      const pw = popup.offsetWidth;
      if (left + pw / 2 > window.innerWidth - 16) left = window.innerWidth - 16 - pw / 2;
      if (left - pw / 2 < 16) left = 16 + pw / 2;
      if (top + popup.offsetHeight > window.innerHeight - 16) {
        top = Math.max(16, y - 40 - popup.offsetHeight);
      }
      popup.style.top = top + 'px';
      popup.style.left = left + 'px';
      popup.style.display = 'block';
      hideToolbar();
    }

    function hidePopup() {
      popup.style.display = 'none';
    }

    // ---------- 保存批注 ----------
    function saveAnnotation() {
      if (!currentSelection) return;
      const note = textarea.value.trim();
      if (!note) return;

      const annotations = getAnnotations();
      annotations.push({
        id: crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2, 8),
        text: currentSelection.text,
        note,
        y: currentSelection.y,
        createdAt: Date.now(),
      });
      saveAnnotations(annotations);
      hidePopup();
      currentSelection = null;
      renderAnnotations();
      highlightAnnotations();
    }

    // ---------- 事件绑定 ----------
    document.addEventListener('mouseup', (e) => {
      // 如果点击在浮层内，不处理
      if (toolbar.contains(e.target as Node) || popup.contains(e.target as Node)) return;

      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || !sel.rangeCount) {
        hideToolbar();
        return;
      }

      const text = sel.toString().trim();
      if (!text || text.length < 2) {
        hideToolbar();
        return;
      }

      const range = sel.getRangeAt(0);
      const rect = range.getBoundingClientRect();
      // 只处理 article 内的选择
      if (!document.querySelector('article')?.contains(range.commonAncestorContainer)) {
        hideToolbar();
        return;
      }

      currentSelection = {
        text,
        range,
        y: rect.top + window.scrollY,
      };
      showToolbar(rect.left + rect.width / 2, rect.top + window.scrollY, text);
    });

    // 点击空白处隐藏工具栏
    document.addEventListener('mousedown', (e) => {
      if (!toolbar.contains(e.target as Node) && !popup.contains(e.target as Node)) {
        hideToolbar();
        hidePopup();
      }
    });

    // 工具栏按钮
    addBtn.addEventListener('click', () => {
      if (!currentSelection) return;
      showPopup(currentSelection.text, parseFloat(toolbar.style.left), parseFloat(toolbar.style.top));
    });

    closeBtn.addEventListener('click', () => {
      hideToolbar();
      currentSelection = null;
    });

    // 浮层按钮
    saveBtn.addEventListener('click', saveAnnotation);
    cancelBtn.addEventListener('click', () => {
      hidePopup();
      currentSelection = null;
    });
    popupCloseBtn.addEventListener('click', () => {
      hidePopup();
      currentSelection = null;
    });

    // Ctrl+Enter 快捷保存
    textarea.addEventListener('keydown', (e) => {
      if (e.ctrlKey && e.key === 'Enter') {
        e.preventDefault();
        saveAnnotation();
      }
    });

    // ---------- 初始化 ----------
    renderAnnotations();
    highlightAnnotations();
  })();
</script>
