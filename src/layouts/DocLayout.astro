---
// =============================================================================
// DocLayout — 文章阅读布局
// 用于 docs 系列页面（/docs/algorithms/xxx、/docs/open-source/xxx）。
// 在 BaseLayout 基础上套上一层「窄栏 + 目录 + 正文排版」结构：
//   - 文章头部：标题 / 作者 / 日期 / 阅读时长 / 标签
//   - 侧边目录（TOC）：根据正文 H2~H4 生成，长文时非常有用
//   - 正文：使用 @tailwindcss/typography 的 prose 类获得优雅排版
//
// 用法：在页面里 <DocLayout ...> ... </DocLayout>，
//       页面负责 render(entry) 并传入 Content 组件、headings、frontmatter。
// =============================================================================
import BaseLayout from './BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import 'katex/dist/katex.min.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  author?: string;
  date?: Date;
  readingTime?: number;
  tags?: string[];
  collectionLabel?: string;
  /** 渲染好的正文内容（由子页面传入） */
  Content: any;
  /** 标题树，用于生成目录 */
  headings?: Heading[];
  /** 返回列表按钮链接（默认 /docs） */
  backHref?: string;
  /** 返回列表按钮文案（默认"返回全部文档"） */
  backLabel?: string;
}

const base = import.meta.env.BASE_URL;

const {
  title,
  description,
  author,
  date,
  readingTime,
  tags = [],
  collectionLabel,
  Content,
  headings = [],
  backHref = `${base}docs`,
  backLabel = '返回全部文档',
} = Astro.props;

// 取深度 2~4 的标题作为目录项
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

const formattedDate = date
  ? new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(date)
  : '';
---

<BaseLayout title={title} description={description}>
  <!-- 文章主体：左占位 + 中间正文（绝对居中）+ 右侧目录 -->
  <div class="mx-auto flex w-full max-w-[100rem] items-start justify-center gap-8 px-4 py-16 sm:px-6 md:px-8">
    <!-- 左占位：平衡右侧目录宽度（未来可放侧边导航） -->
    <div class="hidden w-64 shrink-0 lg:block" aria-hidden="true"></div>

    <!-- 中间正文：限定阅读宽度，绝对居中 -->
    <div class="min-w-0 w-full max-w-4xl xl:max-w-5xl 2xl:max-w-6xl">
      <article>
        <!-- ── 文章头部信息 ─────────────────────────────────── -->
        <header class="mb-10 border-b border-zinc-200 pb-8 dark:border-zinc-800">
          {collectionLabel && <p class="eyebrow mb-4 text-zju-400">{collectionLabel}</p>}
          <h1 class="text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">
            {title}
          </h1>
          <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
            {description}
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
            {author && (
              <span class="flex items-center gap-1.5">
                <Icon name="mdi:account" class="h-4 w-4 text-zju-400" />
                {author}
              </span>
            )}
            {formattedDate && (
              <time class="flex items-center gap-1.5">
                <Icon name="mdi:calendar-blank-outline" class="h-4 w-4 text-zju-400" />
                {formattedDate}
              </time>
            )}
            {readingTime && (
              <span class="flex items-center gap-1.5">
                <Icon name="mdi:clock-outline" class="h-4 w-4 text-zju-400" />
                约 {readingTime} 分钟
              </span>
            )}
          </div>

          {tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span
                  class="rounded-full border border-zinc-300 px-3 py-0.5 text-xs font-medium text-zinc-600 dark:border-zinc-700 dark:text-zinc-300"
                >
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <!-- ── 正文：prose 排版（H1~H6/Blockquote/Table/代码块全部生效）── -->
        <div class="prose prose-zinc max-w-none dark:prose-invert dark:prose-headings:text-zinc-100 prose-a:text-zju-500 dark:prose-a:text-zju-300 prose-pre:border prose-pre:border-zinc-700 prose-pre:bg-zinc-900">
          <Content />
        </div>
      </article>
    </div>

    <!-- 右侧目录（窄屏自动隐藏，sticky 随页面滚动） -->
    <aside class="hidden w-64 shrink-0 self-stretch lg:block">
      {toc.length > 0 && (
        <div class="sticky top-24 rounded-2xl border border-zinc-200 bg-white/70 p-5 dark:border-zinc-800 dark:bg-zinc-900/50 backdrop-blur">
          <p class="eyebrow mb-4 text-zju-400">目录</p>
          <nav class="space-y-2 text-sm">
            {toc.map((h) => (
              <a
                href={`#${h.slug}`}
                class:list={[
                  'block leading-snug transition-colors hover:text-zju-400',
                  h.depth === 3 ? 'pl-4' : '',
                  h.depth === 4 ? 'pl-8' : '',
                  'text-zinc-500 dark:text-zinc-400',
                ]}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      )}
    </aside>
  </div>

  <!-- 返回列表按钮 -->
  <div class="container-page pb-16">
    <a
      href={backHref}
      class="inline-flex items-center gap-2 rounded-full border border-zinc-300 px-5 py-2 text-sm font-medium transition-colors hover:border-zju-400 hover:text-zju-400 dark:border-zinc-700"
    >
      <Icon name="mdi:arrow-left" class="h-4 w-4" />
      {backLabel}
    </a>
  </div>
</BaseLayout>

<style>
  /* 锚点跳转时给吸顶 Header 让出空间 */
  article :is(h2, h3, h4) {
    scroll-margin-top: 7rem;
  }

  /* 正文图片：缩放到 60% 并居中显示。
     :global() 是因为正文由 <Content /> 渲染，元素不带本组件的 scoped 属性。 */
  :global(article .prose img) {
    max-width: 60%;
    height: auto;
    display: block;
    margin: 1.5rem auto;
  }

  /* Mermaid 图表容器 */
  .mermaid {
    margin: 1.5rem auto;
    padding: 1.5rem 1rem;
    border-radius: 0.75rem;
    background: #fff;
    overflow-x: auto;
  }
  html.dark .mermaid {
    background: #0f172a;
  }
  .mermaid svg {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
</style>

<script>
  // ── Mermaid 图表渲染 ─────────────────────────────────────────
  // 把 ```mermaid 代码块渲染为图表。mermaid 按需动态加载，
  // 只有页面里真的存在 mermaid 块时才拉取，避免给所有文档页增加体积。
  (async () => {
    const pres = Array.from(
      document.querySelectorAll<HTMLPreElement>(
        'pre[data-language="mermaid"], pre code.language-mermaid'
      )
    );
    if (!pres.length) return;

    const nodes = pres.map((pre) => {
      const code = pre.querySelector('code');
      const div = document.createElement('div');
      div.className = 'mermaid';
      div.textContent = code?.textContent ?? '';
      pre.replaceWith(div);
      return div;
    });

    try {
      const { default: mermaid } = await import('mermaid');
      const isDark = document.documentElement.classList.contains('dark');
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'default',
        securityLevel: 'loose',
      });
      const results = await mermaid.run({ nodes });
      results.forEach((r, i) => {
        if (r && r.error) console.warn('Mermaid 渲染失败:', r.error);
      });
    } catch (err) {
      console.warn('Mermaid 加载失败:', err);
    }
  })();
</script>

<script>
  // ── 目录滚动监听：高亮当前浏览章节 ──────────────────────────
  const tocLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('aside nav a[href^="#"]')
  );
  const headings = Array.from(
    document.querySelectorAll<HTMLElement>('article h2, article h3, article h4')
  );

  if (tocLinks.length && headings.length) {
    const linkFor = (slug: string) =>
      tocLinks.find((a) => a.getAttribute('href') === `#${slug}`);

    const setActive = (slug: string | null) => {
      tocLinks.forEach((a) => {
        a.style.color = '';
        a.style.textShadow = '';
      });
      if (!slug) return;
      const link = linkFor(slug);
      if (link) {
        link.style.color = '#38bdf8';
        link.style.textShadow = '0 0 12px rgba(56, 189, 248, 0.7)';
      }
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]) setActive(visible[0].target.id);
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      );
      headings.forEach((h) => observer.observe(h));
    }

    // 初始高亮第一个标题
    setActive(headings[0].id);
  }
</script>
