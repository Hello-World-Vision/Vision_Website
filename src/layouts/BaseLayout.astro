---
// =============================================================================
// BaseLayout — 全局布局（所有页面共用）
// 职责：
//   1. 引入全局样式与自托管字体（Inter + JetBrains Mono，无需外网）
//   2. 提供 <html lang="zh-CN" class="dark">（深色为默认主题）
//   3. 渲染全站固定的「科技蓝光晕背景」层
//   4. 挂载 Header / Footer，预留 <slot /> 供子页面填充内容
//
// 若要在「每个页面」统一出现的东西（统计代码、粒子背景等），在此处添加即可。
// =============================================================================
import '../styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** 页面标题（会自动追加站点名） */
  title?: string;
  /** 页面描述（SEO） */
  description?: string;
  /** 是否隐藏页脚（如全屏沉浸式页面可用） */
  hideFooter?: boolean;
  /** 单屏模式：锁死 100vh，不允许滚动，Header/主体/Footer 刚好适配一屏 */
  singleScreen?: boolean;
}

const {
  title = '浙江大学 RoboMaster Vision',
  description = '浙江大学 RoboMaster 视觉组 —— 用视觉重新定义战场。',
  hideFooter = false,
  singleScreen = false,
} = Astro.props;

const pageTitle =
  title === '浙江大学 RoboMaster Vision' ? title : `${title} · 浙江大学 RoboMaster Vision`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#003f88" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png?v=2`} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{pageTitle}</title>

    <!-- 主题初始化：在首帧渲染前同步 localStorage 中的主题，避免深/浅闪烁 -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('zju-theme') === 'light') {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>

    <!-- 密码门：已在本会话解锁过则隐藏锁屏（避免刷新后闪屏） -->
    <script is:inline>
      (function () {
        try {
          if (sessionStorage.getItem('zju-auth') === 'ok') {
            var s = document.createElement('style');
            s.textContent = '#site-lock{display:none !important}';
            document.head.appendChild(s);
          }
        } catch (_) {}
      })();
    </script>
  </head>

  <body
    class:list={[
      'relative min-h-screen overflow-x-clip',
      singleScreen && 'flex flex-col overflow-hidden',
    ]}
  >
    <!-- 密码门遮罩：未解锁时覆盖全站 -->
    <div
      id="site-lock"
      class="fixed inset-0 z-[100] flex flex-col items-center justify-center gap-5 bg-zinc-950 px-6"
    >
      <p class="font-mono text-3xl font-black tracking-[0.15em] text-white sm:text-4xl">
        ZJU RoboMaster Vision
      </p>
      <p class="font-mono text-sm text-zinc-400">请输入访问密码以继续</p>
      <form id="site-lock-form" class="flex items-center gap-3">
        <input
          id="site-lock-input"
          type="password"
          placeholder="Password"
          autocomplete="off"
          autofocus
          class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 font-mono text-sm text-white outline-none transition-colors focus:border-sky-400"
        />
        <button
          type="submit"
          class="rounded-lg bg-sky-500 px-5 py-2 font-mono text-sm font-semibold text-white transition-colors hover:bg-sky-400"
        >
          进入
        </button>
      </form>
      <p id="site-lock-msg" class="hidden font-mono text-xs text-red-400">
        密码错误，请重试
      </p>
    </div>

    <!--
      全站固定背景层：三团"求是蓝/科技蓝"光晕 + 淡网格，营造空间纵深感。
      它永远在最底层（z-0），具体页面内容放在 z-10 之上即可。
      想要替换/关闭它：直接删除这个 <div> 即可。
    -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
      <div
        class="absolute -left-40 -top-40 h-[620px] w-[620px] rounded-full"
        style="background: radial-gradient(circle, rgba(74,143,221,0.16), transparent 65%); filter: blur(90px); animation: blobBreathe 14s ease-in-out infinite;"
      ></div>
      <div
        class="absolute -bottom-48 -right-40 h-[520px] w-[520px] rounded-full"
        style="background: radial-gradient(circle, rgba(56,189,248,0.12), transparent 65%); filter: blur(90px); animation: blobBreathe 12s ease-in-out 4s infinite;"
      ></div>
      <div
        class="absolute left-1/2 top-1/2 h-[420px] w-[420px] -translate-x-1/2 -translate-y-1/2 rounded-full"
        style="background: radial-gradient(circle, rgba(167,139,250,0.08), transparent 65%); filter: blur(90px); animation: blobBreathe 16s ease-in-out 8s infinite;"
      ></div>
    </div>

    <!-- 顶部导航 -->
    <Header />

    <!-- 页面主体：子页面内容渲染位置 -->
    <main class="relative z-10">
      <slot />
    </main>

    <!-- 页脚：单屏模式下悬浮在首屏底部，不占用文档流高度 -->
    {!hideFooter &&
      (singleScreen ? (
        <div class="absolute inset-x-0 bottom-0 z-20 bg-zinc-950/60 backdrop-blur-md">
          <Footer />
        </div>
      ) : (
        <Footer />
      ))}
  </body>

  <!-- 密码门解锁逻辑 -->
  <script is:inline>
    (function () {
      // 明文密码不出现在源码中。这里只保存 PBKDF2 加盐哈希，
      // 即使用仓库公开，也无法直接读出密码，暴力破解需大量计算。
      var SALT = 'fc5e06f784fc4a8b4ae99f651c31056b';
      var HASH = '0fb97a50ee2e07b21c510228c83fe25025af93ee2d6b491d958683cabbb11309';
      var ITERATIONS = 250000;

      var lock = document.getElementById('site-lock');
      if (!lock) return;
      if (sessionStorage.getItem('zju-auth') === 'ok') {
        lock.style.display = 'none';
        return;
      }

      // Web Crypto 的 PBKDF2 需要 https（GitHub Pages 满足）或 localhost
      if (!window.crypto || !window.crypto.subtle) {
        var noSupport = document.createElement('p');
        noSupport.className = 'font-mono text-xs text-red-400';
        noSupport.textContent = '当前环境不支持安全校验，请使用 HTTPS 访问';
        lock.appendChild(noSupport);
        return;
      }

      var enc = new TextEncoder();
      var saltBytes = hexToBytes(SALT);

      function hexToBytes(hex) {
        var bytes = new Uint8Array(hex.length / 2);
        for (var i = 0; i < bytes.length; i++) {
          bytes[i] = parseInt(hex.substr(i * 2, 2), 16);
        }
        return bytes;
      }

      function bytesToHex(bytes) {
        var hex = '';
        for (var i = 0; i < bytes.length; i++) {
          hex += bytes[i].toString(16).padStart(2, '0');
        }
        return hex;
      }

      async function derive(input) {
        var key = await crypto.subtle.importKey(
          'raw',
          enc.encode(input),
          'PBKDF2',
          false,
          ['deriveBits']
        );
        var bits = await crypto.subtle.deriveBits(
          { name: 'PBKDF2', salt: saltBytes, iterations: ITERATIONS, hash: 'SHA-256' },
          key,
          256
        );
        return bytesToHex(new Uint8Array(bits));
      }

      var form = document.getElementById('site-lock-form');
      var input = document.getElementById('site-lock-input');
      var msg = document.getElementById('site-lock-msg');

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var entered = input.value;
        // 先做一次廉价校验，完全为空时直接报错，避免无谓的耗时
        if (!entered) {
          msg.classList.remove('hidden');
          return;
        }
        derive(entered).then(function (digest) {
          var ok = false;
          try {
            // 恒定时间比较，避免时序侧信道
            var a = digest;
            var b = HASH;
            ok = a.length === b.length;
            if (ok) {
              var diff = 0;
              for (var i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
              ok = diff === 0;
            }
          } catch (_) {
            ok = false;
          }
          if (ok) {
            try {
              sessionStorage.setItem('zju-auth', 'ok');
            } catch (_) {}
            lock.style.display = 'none';
          } else {
            msg.classList.remove('hidden');
            input.value = '';
            input.select();
          }
        });
      });
    })();
  </script>
</html>
