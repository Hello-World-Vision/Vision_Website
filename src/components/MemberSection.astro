---
// =============================================================================
// MemberSection — 单名成员的"反重力档案卡"（一个成员 = 一个整屏区块）
// 视觉复刻参考仓库 superpower.icu/members ：
//   - 左右两栏布局（图片 | 档案），相邻成员交替反转（奇偶 order 互换）
//   - 巨型水印编号（背景描边数字，data-profile 控制）
//   - 照片轮播（≥2 张时显示切换按钮 / 指示点；1 张则静态展示）
//   - 徽章 / 英文名 / 职务 / 贡献经历信息块 / 技术栈标签
//
// 数据来源：src/content/members/*.md 的 frontmatter，由父页面传入。
// =============================================================================
import { Image } from 'astro:assets';

interface Props {
  /** 中文名 */
  name: string;
  /** 英文名 */
  nameEn?: string;
  /** 头像（ImageMetadata，来自 z.image()） */
  avatar?: ImageMetadata;
  /** 照片列表（轮播用） */
  photos?: ImageMetadata[];
  /** 职务 */
  position: string;
  /** 徽章 */
  badges?: string[];
  /** 技术栈 */
  tech?: string[];
  /** 主要贡献 */
  contribution: string;
  /** 经历 */
  experience?: string;
  /** 社交链接 */
  socials?: { label: string; url: string }[];
  /** 序号（用于水印与交替布局） */
  index: number;
  /** 渲染好的 Markdown 正文（可选，来自 render(entry)） */
  Content?: any;
}

const {
  name,
  nameEn,
  avatar,
  photos = [],
  position,
  badges = [],
  tech = [],
  contribution,
  experience,
  socials = [],
  index,
  Content,
} = Astro.props;

// 轮播图片：优先 photos，没有则用 avatar，再没有就显示占位
const slides = photos.length > 0 ? photos : avatar ? [avatar] : [];
const isReversed = index % 2 === 0; // 偶数序号成员左右反转布局
const missionNo = String(index + 1).padStart(2, '0');
---

<section
  id={`member-${index}`}
  data-profile={missionNo}
  class="relative flex min-h-[100svh] items-center py-24"
>
  <!-- 巨型水印编号（右侧半透明描边数字） -->
  <span
    class="pointer-events-none absolute right-4 top-16 select-none font-mono text-[10rem] font-black leading-none text-transparent opacity-40 lg:text-[13rem]"
    style={{ WebkitTextStroke: '1px rgba(148,163,184,0.25)' }}
    aria-hidden="true"
  >
    {missionNo}
  </span>

  <div class="container-page grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
    <!-- ── 左侧：照片 ─────────────────────────────────── -->
    <div class:list={['relative reveal', isReversed && 'lg:order-2']}>
      <!-- 装饰性偏移边框 -->
      <div
        class="absolute -inset-3 -z-10 rounded-2xl border border-sky-400/20 lg:inset-4 lg:-right-3"
        aria-hidden="true"
      ></div>

      <div
        data-carousel
        class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-zinc-200 shadow-2xl dark:border-zinc-800"
      >
        {slides.length > 0 ? (
          slides.map((img, i) => (
            <div
              data-slide
              class:list={[
                'absolute inset-0 transition-all duration-700',
                i === 0 ? 'opacity-100' : 'opacity-0',
              ]}
            >
              <Image src={img} alt={`${name} 的照片 ${i + 1}`} class="h-full w-full object-cover" />
            </div>
          ))
        ) : (
          <div class="grid h-full w-full place-items-center bg-gradient-to-br from-zju-800 to-zju-950">
            <span class="font-mono text-sm tracking-widest text-sky-300/70">NO IMAGE</span>
          </div>
        )}

        {slides.length > 1 && (
          <>
            <button
              type="button"
              data-carousel-prev
              aria-label="上一张"
              class="absolute left-3 top-1/2 z-10 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full border border-white/30 bg-black/45 text-xl text-white backdrop-blur transition-all hover:scale-110 hover:bg-sky-500/70"
            >
              ‹
            </button>
            <button
              type="button"
              data-carousel-next
              aria-label="下一张"
              class="absolute right-3 top-1/2 z-10 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full border border-white/30 bg-black/45 text-xl text-white backdrop-blur transition-all hover:scale-110 hover:bg-sky-500/70"
            >
              ›
            </button>
            <div class="absolute bottom-4 left-1/2 z-10 flex -translate-x-1/2 gap-2">
              {slides.map((_, i) => (
                <span
                  data-carousel-dot
                  class:list={[
                    'h-1 w-7 rounded-full transition-all',
                    i === 0 ? 'bg-white' : 'bg-white/40',
                  ]}
                ></span>
              ))}
            </div>
          </>
        )}
      </div>
    </div>

    <!-- ── 右侧：档案 ─────────────────────────────────── -->
    <article class:list={['reveal', isReversed && 'lg:order-1']}>
      <p class="eyebrow mb-6 text-sky-400">
        Mission {missionNo} / Vision System
      </p>

      <!-- 徽章 -->
      {badges.length > 0 && (
        <div class="mb-5 flex flex-wrap gap-2">
          {badges.map((b) => (
            <span
              class="rounded-xl border border-zinc-300 px-3 py-1.5 text-xs font-bold backdrop-blur dark:border-zinc-700"
            >
              {b}
            </span>
          ))}
        </div>
      )}

      <h2 class="text-4xl font-black leading-tight tracking-tight sm:text-5xl">
        {name}
        {nameEn && (
          <span class="mt-2 block text-base font-bold text-zinc-500 dark:text-zinc-400">
            {nameEn}
          </span>
        )}
      </h2>
      <p class="mt-3 text-lg font-bold text-sky-400">{position}</p>

      <!-- 贡献 / 经历 信息块 -->
      <div class="mt-8 space-y-5">
        <div class="border-t border-zinc-300 pt-4 dark:border-zinc-700">
          <h3 class="mb-2 text-sm font-black uppercase tracking-wide">主要贡献</h3>
          <p class="text-sm leading-7 text-zinc-600 dark:text-zinc-400">{contribution}</p>
        </div>
        {experience && (
          <div class="border-t border-zinc-300 pt-4 dark:border-zinc-700">
            <h3 class="mb-2 text-sm font-black uppercase tracking-wide">经历</h3>
            <p class="text-sm leading-7 text-zinc-600 dark:text-zinc-400">{experience}</p>
          </div>
        )}
      </div>

      <!-- 技术栈标签 -->
      {tech.length > 0 && (
        <div class="mt-7 flex flex-wrap gap-2.5">
          {tech.map((t) => (
            <span
              class="rounded-xl border border-zinc-300 px-3 py-1.5 font-mono text-xs font-bold text-zinc-600 backdrop-blur dark:border-zinc-700 dark:text-zinc-300"
            >
              {t}
            </span>
          ))}
        </div>
      )}

      <!-- 社交链接 -->
      {socials.length > 0 && (
        <div class="mt-7 flex flex-wrap gap-4 text-sm font-semibold text-sky-500 dark:text-sky-300">
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
              {s.label} ↗
            </a>
          ))}
        </div>
      )}

      <!-- Markdown 正文（可选） -->
      {Content && (
        <div class="prose prose-sm mt-8 max-w-none text-zinc-600 dark:prose-invert dark:text-zinc-400">
          <Content />
        </div>
      )}
    </article>
  </div>
</section>
