---
// =============================================================================
// Header — 全站顶部导航栏
// 特性：
//   - 吸顶 + 毛玻璃（backdrop-blur）
//   - Logo 为浙大黑白校徽（反色为纯白），标题为 ZJU Robomaster Vision
//   - 英文导航菜单（Home / Induction Training / About / Project）
//   - hover 时文字发光 + 底部高亮下划线
//   - 内置深浅色切换（ThemeToggle）与 GitHub 外链
// 新增导航入口：在 navItems 数组里加一项即可。
// =============================================================================
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';

interface NavItem {
  label: string;
  href: string;
  /** 精确匹配（true：仅当前路径等于 href 时高亮） */
  exact?: boolean;
}

const base = import.meta.env.BASE_URL;

const navItems: NavItem[] = [
  { label: 'Home', href: base, exact: true },
  { label: 'Induction Training', href: `${base}induction-training` },
  { label: 'About', href: `${base}about` },
  { label: 'Project', href: `${base}project` },
];

// 判断激活态：非 exact 的导航项，其 href 是当前路径的前缀时也视为激活
const isActive = (item: NavItem) =>
  item.exact ? Astro.url.pathname === item.href : Astro.url.pathname.startsWith(item.href);
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-zinc-950/50 backdrop-blur-xl"
>
  <div class="container-page flex h-16 items-center justify-between">
    <!-- 左侧站点名 -->
    <a href={base} class="group flex items-center gap-3">
      <span class="font-mono text-sm font-semibold tracking-[0.18em] text-zinc-200 transition-colors duration-300 group-hover:text-white">
        ZJU Robomaster Vision
      </span>
    </a>

    <!-- 右侧导航 -->
    <nav class="flex items-center gap-1 sm:gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'group relative px-3 py-2 font-mono text-[13px] font-medium tracking-wider transition-all duration-300 sm:px-4',
            isActive(item)
              ? 'text-sky-300 [text-shadow:0_0_12px_rgba(56,189,248,0.7)]'
              : 'text-zinc-400 hover:text-sky-300 hover:[text-shadow:0_0_12px_rgba(56,189,248,0.6)]',
          ]}
        >
          {item.label}
          <span
            class:list={[
              'absolute -bottom-0.5 left-1/2 h-px -translate-x-1/2 bg-sky-400 shadow-[0_0_8px_rgba(56,189,248,0.9)] transition-all duration-300',
              isActive(item)
                ? 'w-full'
                : 'w-0 group-hover:w-full',
            ]}
          ></span>
        </a>
      ))}

      <span class="mx-1 hidden h-4 w-px bg-zinc-700 sm:block"></span>

      <!-- 外部链接：GitHub -->
      <a
        href="https://github.com/ZJU-Vision"
        target="_blank"
        rel="noopener noreferrer"
        title="GitHub"
        class="grid h-9 w-9 place-items-center rounded-full text-zinc-400 transition-colors hover:bg-white/10 hover:text-sky-300"
      >
        <Icon name="mdi:github" class="h-5 w-5" />
      </a>

      <!-- 深浅色切换 -->
      <ThemeToggle />
    </nav>
  </div>
</header>
