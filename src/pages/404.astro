---
// 404 页面
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="页面不存在" description="页面不存在。">
  <div class="container-page grid min-h-[70vh] place-items-center py-24 text-center">
    <div>
      <p class="font-mono text-7xl font-black text-transparent" style={{ WebkitTextStroke: '2px rgba(56,189,248,0.5)' }}>
        404
      </p>
      <h1 class="mt-6 text-3xl font-bold">信号丢失 · SIGNAL LOST</h1>
      <p class="mt-3 text-zinc-500">你要找的页面不存在，或者已被移动。</p>
      <a
        href="/"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-zju-800 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-zju-700"
      >
        <Icon name="mdi:home" class="h-4 w-4" />
        返回首页
      </a>
    </div>
  </div>
</BaseLayout>
