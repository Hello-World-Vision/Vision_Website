---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import cardDji from '../assets/card-dji.png';

const base = import.meta.env.BASE_URL;

// 每个项目块都只需要修改这组数据：图片、标题和跳转地址。
const projects = [
  { title: '哨兵导航', subtitle: 'SENTINEL NAVIGATION', href: 'https://github.com/Polyacetone/HWSentryNav26/blob/main/TUTORIAL.md', image: `${base}images/project/sentry-navigation.png`, icon: 'mdi:radar', external: true },
  { title: '飞镖视觉', subtitle: 'DART VISION', href: 'https://github.com/Hello-World-Vision/dart_2026', image: `${base}images/project/dart-vision.png`, icon: 'mdi:target', external: true },
  { title: '雷达视觉', subtitle: 'RADAR VISION', href: 'https://github.com/Hello-World-Vision/RadarStation2026/tree/cicada', image: `${base}images/project/radar-vision.png`, icon: 'mdi:radar', external: true },
  { title: '自瞄', subtitle: 'AUTO AIM', href: 'https://github.com/Hello-World-Vision/autoaim2026', image: `${base}images/project/auto-aim.png`, icon: 'mdi:target', external: true },
  { title: '哨兵决策', subtitle: 'SENTRY DECISION', href: 'https://github.com/Hello-World-Vision/behavior_sentry_2026', image: `${base}images/project/sentry-decision.png`, icon: 'mdi:robot-outline', external: true },
  { title: '神经网络模型训练&数据集', subtitle: 'NN TRAINING & DATASET', href: '#', image: `${base}images/project/nn-training.png`, icon: 'mdi:brain' },
  { title: '自定义客户端', subtitle: 'CUSTOM CLIENT', href: 'https://github.com/Hello-World-Vision/client_2026', image: `${base}images/project/custom-client.png`, icon: 'mdi:robot-outline', external: true },
  { title: '待定', subtitle: 'PROJECT 08', href: '#', image: cardDji.src, icon: 'mdi:map-marker-path' },
];
---

<BaseLayout title="Project" description="ZJU RoboMaster 视觉组项目入口" lock>
  <main class="project-page container-page py-16 sm:py-20">
    <header class="mx-auto mb-12 max-w-3xl text-center">
      <p class="eyebrow text-sky-400">HELLO WORLD / PROJECTS</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-6xl">项目交接与传承</h1>
      <p class="mx-auto mt-5 max-w-4xl text-base leading-8 text-zinc-500 dark:text-zinc-400">
        上赛季视觉组的核心项目跳转，内置文件以较为详细的培养、教学为主，引导新人快速上手，逐渐提升自主学习和实践能力。希望老人为后续的继任者负责，为自己的心血做一个完美的收尾；希望新人好好把握老人的这种跨越时间的细心培养，在学习入队前基础培训之后，快速接收队内项目，加油！
      </p>
    </header>

    <section class="mx-auto grid max-w-5xl grid-cols-1 gap-12 sm:grid-cols-2" aria-label="项目列表">
      {projects.map((project, index) => (
        <a href={project.href} target={project.external ? '_blank' : undefined} rel={project.external ? 'noreferrer' : undefined} class="project-tile group" aria-label={`进入${project.title}`}>
          <div class="project-tile__image" style={{ backgroundImage: `url('${project.image}')` }}></div>
          <div class="project-tile__shade"></div>
          <div class="relative z-10 flex min-h-64 flex-col justify-between p-5">
            <div class="flex items-center justify-between">
              <span class="grid h-10 w-10 place-items-center rounded-xl border border-white/20 bg-black/20 text-sky-300 backdrop-blur-sm">
                <Icon name={project.icon} class="h-5 w-5" />
              </span>
              <span class="font-mono text-xs text-white/50">0{index + 1}</span>
            </div>
            <div>
              <p class="font-mono text-[10px] tracking-[0.2em] text-sky-300">{project.subtitle}</p>
              <h2 class="mt-2 text-2xl font-bold text-white">{project.title}</h2>
              <span class="mt-4 inline-flex items-center gap-1 text-sm text-white/60 transition-colors group-hover:text-sky-300">
                进入项目 <Icon name="mdi:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </span>
            </div>
          </div>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .project-tile { position: relative; overflow: hidden; min-height: 16rem; border: 1px solid rgba(255,255,255,.1); border-radius: 1rem; background: #18181b; transition: transform .35s ease, border-color .35s ease, box-shadow .35s ease; }
  .project-tile:hover { transform: translateY(-6px); border-color: rgba(56,189,248,.65); box-shadow: 0 18px 38px rgba(0,0,0,.3), 0 0 28px rgba(56,189,248,.14); }
  .project-tile__image, .project-tile__shade { position: absolute; inset: 0; }
  .project-tile__image { background-position: center; background-size: cover; opacity: .72; transition: transform .7s ease, opacity .4s ease; }
  .project-tile:hover .project-tile__image { transform: scale(1.1); opacity: .95; }
  .project-tile__shade { background: linear-gradient(180deg, rgba(0,0,0,.2), rgba(0,0,0,.82)); }
</style>
