---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const daily = [42, 58, 37, 65, 81, 73, 96, 88, 104, 92, 118, 126, 109, 134, 121, 147, 139, 156, 143, 168, 151, 176, 162, 184, 171, 193, 180, 201, 188, 214, 205];
const hourly = [4, 2, 1, 1, 0, 1, 3, 8, 14, 19, 23, 28, 31, 26, 29, 35, 42, 48, 45, 39, 32, 25, 17, 9];
const maxDaily = Math.max(...daily);
const maxHourly = Math.max(...hourly);
const points = hourly.map((value, index) => `${(index / 23) * 100},${100 - (value / maxHourly) * 82}`).join(' ');
const days = daily.map((_, index) => index + 1);
const total = daily.reduce((sum, value) => sum + value, 0);
---

<BaseLayout title="Visit" description="网站访问数据统计">
  <main class="container-page py-16 sm:py-20">
    <header class="mx-auto mb-12 max-w-3xl text-center">
      <p class="eyebrow text-sky-400">HELLO WORLD / VISIT</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-6xl">访问统计</h1>
      <p class="mt-5 text-base leading-8 text-zinc-500 dark:text-zinc-400">记录每一次访问，让我们知道这份文档正在被阅读与传承。</p>
    </header>

    <section class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-3">
      <div class="stat-card"><span>本月访问量</span><strong>{total.toLocaleString()}</strong><small>累计访问</small></div>
      <div class="stat-card"><span>今日访问量</span><strong>{daily[daily.length - 1]}</strong><small>截至当前统计周期</small></div>
      <div class="stat-card"><span>高峰时段</span><strong>{String(hourly.indexOf(maxHourly)).padStart(2, '0')}:00</strong><small>访问最集中时段</small></div>
    </section>

    <section class="chart-card mx-auto mt-6 max-w-6xl">
      <div class="mb-8 flex items-end justify-between"><div><p class="eyebrow text-sky-400">DAILY TRAFFIC</p><h2 class="mt-2 text-2xl font-bold">本月每日访问量</h2></div><span class="font-mono text-xs text-zinc-500">柱形图 · 每日</span></div>
      <div class="bar-chart" aria-label="本月每日访问量柱形图">
        {daily.map((value, index) => <div class="bar-column"><span class="bar-value">{value}</span><div class="bar" style={{ height: `${(value / maxDaily) * 100}%` }}></div><span class="bar-label">{days[index]}</span></div>)}
      </div>
    </section>

    <section class="chart-card mx-auto mt-6 max-w-6xl">
      <div class="mb-8 flex items-end justify-between"><div><p class="eyebrow text-sky-400">HOURLY TRAFFIC</p><h2 class="mt-2 text-2xl font-bold">一天中的访问时段</h2></div><span class="font-mono text-xs text-zinc-500">折线图 · 00:00—23:00</span></div>
      <div class="line-chart" aria-label="一天中每个时段访问量折线图">
        <div class="line-grid"></div><svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><polyline points={points} fill="none" stroke="#38bdf8" stroke-width="1.5" vector-effect="non-scaling-stroke" /><polygon points={`0,100 ${points} 100,100`} fill="url(#lineFill)" /><defs><linearGradient id="lineFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#38bdf8" stop-opacity=".3" /><stop offset="1" stop-color="#38bdf8" stop-opacity="0" /></linearGradient></defs></svg>
        <div class="line-labels">{hourly.map((_, index) => <span>{String(index).padStart(2, '0')}</span>)}</div>
      </div>
    </section>
    <p class="mx-auto mt-6 max-w-6xl text-center text-xs text-zinc-500">当前图表使用页面内置示例数据。接入真实统计服务后，将此处数据替换为统计接口返回值。</p>
  </main>
</BaseLayout>

<style>
  .stat-card,.chart-card{border:1px solid rgba(255,255,255,.1);border-radius:1rem;background:rgba(24,24,27,.62);backdrop-filter:blur(18px)}
  .stat-card{display:flex;min-height:8rem;flex-direction:column;justify-content:center;padding:1.5rem}.stat-card span{font-family:ui-monospace;font-size:.75rem;color:#a1a1aa}.stat-card strong{margin-top:.45rem;font-size:2rem;color:#e4e4e7}.stat-card small{font-size:.75rem;color:#71717a}.chart-card{padding:1.25rem}@media(min-width:640px){.chart-card{padding:2rem}}
  .bar-chart{display:flex;height:18rem;align-items:end;gap:clamp(2px,1vw,10px);border-bottom:1px solid #3f3f46;padding:1.5rem .25rem 0}.bar-column{display:flex;height:100%;min-width:0;flex:1;flex-direction:column;align-items:center;justify-content:end}.bar{width:100%;max-width:1.5rem;border-radius:5px 5px 0 0;background:linear-gradient(#38bdf8,#2563eb);box-shadow:0 0 15px #38bdf833;transition:filter .2s}.bar-column:hover .bar{filter:brightness(1.35)}.bar-value{margin-bottom:.3rem;font:10px ui-monospace;color:#71717a}.bar-label{margin-top:.5rem;font:10px ui-monospace;color:#71717a}
  .line-chart{position:relative;height:18rem;padding:1rem .25rem 2rem}.line-chart svg{position:absolute;inset:1rem .25rem 2rem;width:calc(100% - .5rem);height:calc(100% - 3rem);overflow:visible}.line-grid{position:absolute;inset:1rem .25rem 2rem;background:repeating-linear-gradient(to bottom,transparent 0,transparent calc(25% - 1px),#3f3f464d 25%,#3f3f464d 25%)}.line-labels{position:absolute;bottom:0;left:.25rem;right:.25rem;display:flex;justify-content:space-between;font:10px ui-monospace;color:#71717a}.line-labels span:nth-child(n+2):nth-child(-n+23){display:none}@media(min-width:640px){.line-labels span:nth-child(2n){display:block}.line-labels span:nth-child(odd){display:none}}
</style>
