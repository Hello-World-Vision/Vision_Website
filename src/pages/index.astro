---
// =============================================================================
// 首页 src/pages/index.astro（路由：/）
// 单屏布局（Single-screen layout）：
//   1. Hero 首屏 —— 粒子网络背景（ParticleCanvas）+ 左右分栏
//      （左：渐变大字排版；右：Hello World 队徽悬浮动画）
//   2. 底部入口卡片 —— Induction Training / About / Project（毛玻璃 + hover 发光）
// 高度严格限制为 100vh - 4rem（Header 高度），overflow-hidden 干掉垂直滚动条。
// =============================================================================
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ParticleCanvas from '../components/ParticleCanvas.astro';
import teamLogo from '../assets/team-logo.png';
import zjuLogo from '../assets/zju-logo.png';
import cardDji from '../assets/card-dji.png';
import cardRm from '../assets/card-rm.png';
import cardGithub from '../assets/card-github.png';

const base = import.meta.env.BASE_URL;

const cards = [
  {
    href: `${base}induction-training`,
    icon: 'mdi:school',
    title: 'Induction Training',
    description: '争者留其名',
    bgImage: cardDji.src,
  },
  {
    href: `${base}about`,
    icon: 'mdi:account-group',
    title: 'About',
    description: '是关于 ZJU RoboMaster 视觉组',
    bgImage: cardRm.src,
  },
  {
    href: `${base}project`,
    icon: 'mdi:rocket-launch',
    title: 'Project',
    description: '项目交接文档',
    bgImage: cardGithub.src,
  },
];
---

<BaseLayout singleScreen>
  <!-- ============================================================
       HERO 首屏（单屏，无滚动条）
       高度 = 100vh - 4rem（Header 占 4rem），内部自行分配空间
       ============================================================ -->
  <section class="relative h-full overflow-hidden">
    <!-- 预留的 Canvas / 3D 渲染容器 -->
    <div id="hero-canvas-container" class="absolute inset-0 z-0">
      <!-- 科技网格光层 -->
      <div class="bg-tech-grid absolute inset-0 opacity-70"></div>
      <!-- 粒子网络背景 -->
      <ParticleCanvas count={110} linkDistance={150} class="absolute inset-0 h-full w-full" />
    </div>

    <div class="relative z-10 flex h-full flex-col justify-center gap-16">
      <!-- ── 中央区域：左右分栏（-translate-y 强制上移主体） ── -->
      <div class="container-page -translate-y-12 flex items-center justify-between gap-8 py-6 md:-translate-y-20 md:gap-12">
        <!-- 左：Typography -->
        <div class="max-w-2xl shrink">
          <h1 class="leading-tight">
            <span
              class="block whitespace-nowrap text-4xl font-bold tracking-tight bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent md:text-5xl"
            >
              ZJU Robomaster's
            </span>
            <span
              class="mt-4 block whitespace-nowrap text-5xl font-extrabold tracking-tight text-white md:text-7xl"
            >
              Official Website
            </span>
          </h1>
          <p class="mt-6 font-mono text-sm text-gray-400">
            98%的人在这里被打败，但100%的人收获成长
          </p>
        </div>

        <!-- 右：校徽 + 队徽 双 Logo 并排（悬浮呼吸动画 + 辉光融合） -->
        <div class="relative shrink-0">
          <div class="hero-logo relative flex flex-row items-center justify-center gap-8 md:gap-12">
            <!-- 背后的辉光（随 Logo 一起浮动，mix-blend-screen 会与其融合） -->
            <div
              aria-hidden="true"
              class="absolute left-1/2 top-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-sky-500/20 blur-[80px]"
            ></div>
            <Image
              src={zjuLogo}
              alt="浙江大学校徽"
              class="relative mix-blend-screen w-40 object-contain animate-pulse transition-transform duration-300 hover:scale-105 md:w-48 lg:w-56"
            />
            <Image
              src={teamLogo}
              alt="Hello World 队徽"
              class="relative mix-blend-screen w-40 object-contain animate-pulse transition-transform duration-300 hover:scale-105 md:w-48 lg:w-56"
            />
          </div>
        </div>
      </div>

      <!-- ── 底部：三张入口卡片（max-w-[68rem] 稍收窄） ── -->
      <div class="mx-auto grid w-full max-w-[68rem] grid-cols-3 gap-6 px-6 sm:px-8 sm:gap-8">
        {cards.map((card) => (
          <a
            href={card.href}
            class="group relative min-h-[12rem] overflow-hidden rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md transition-all duration-300 hover:scale-105 hover:border-sky-400/60 hover:bg-white/10 hover:shadow-[0_0_30px_rgba(56,189,248,0.18)]"
          >
            <!-- 第一层：背景图片层（hover 时缓慢放大） -->
            <div
              class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
              style={{ backgroundImage: `url('${card.bgImage}')` }}
            ></div>
            <!-- 第二层：暗黑遮罩层（hover 时提亮） -->
            <div class="absolute inset-0 bg-black/65 transition-colors duration-500 group-hover:bg-black/40"></div>
            <!-- 第三层：内容层 -->
            <div class="relative z-10 flex min-h-[12rem] flex-col items-center justify-center gap-2 p-4 text-center sm:p-6">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-sky-400/10 text-sky-400 transition-transform duration-300 group-hover:scale-110">
                <Icon name={card.icon} class="h-5 w-5" />
              </span>
              <span class="font-mono text-xs font-semibold tracking-wide text-zinc-200 transition-colors duration-300 group-hover:text-white sm:text-sm">
                {card.title}
              </span>
              <span class="hidden text-xs leading-5 text-zinc-500 transition-colors duration-300 group-hover:text-zinc-300 md:block">
                {card.description}
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes heroFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-18px);
    }
  }

  .hero-logo {
    animation: heroFloat 6s ease-in-out infinite;
  }
</style>
