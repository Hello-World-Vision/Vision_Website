---
// =============================================================================
// 入组培训总览页 src/pages/induction-training/index.astro（路由：/induction-training）
// 自动列出 src/content/induction/ 下的全部培训文档，按日期倒序排列。
// 新增文档 = 在 src/content/induction/ 下新建 .md 文件即可，此处自动出现。
// =============================================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const published = <T extends { data: { draft?: boolean } }>(entries: T[]): T[] =>
  entries.filter((e) => !e.data.draft);

const docs = published(await getCollection('induction')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const base = import.meta.env.BASE_URL;

const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' }).format(d);
---

<BaseLayout
  title="Induction Training"
  description="浙江大学 RoboMaster 视觉组入组培训 —— 新队员必修课文档中心。"
>
  <div class="container-page py-16">
    <!-- 页头 -->
    <header class="mb-12">
      <p class="eyebrow mb-4 text-sky-400">INDUCTION TRAINING</p>
      <h1 class="text-4xl font-black tracking-tight sm:text-5xl">入组培训</h1>
      <p class="mt-4 max-w-xl text-zinc-600 dark:text-zinc-400">
        新队员必修课。新增文档只需在
        <code class="rounded bg-zinc-200 px-1.5 py-0.5 font-mono text-sm dark:bg-zinc-800">
          src/content/induction/
        </code>
        下添加 Markdown 文件。
      </p>
    </header>

    <!-- 文档列表 -->
    {docs.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-zinc-700">
        还没有内容，去 <code>src/content/induction/</code> 下新建第一个 .md 文件吧。
      </p>
    ) : (
      <ul class="grid gap-4 md:grid-cols-2">
        {docs.map((doc) => (
          <li>
            <a
              href={`${base}induction-training/${doc.id}`}
              class="tech-card block p-5"
            >
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-bold">{doc.data.title}</h3>
                <Icon name="mdi:arrow-right" class="mt-1 h-4 w-4 shrink-0 text-zju-400" />
              </div>
              <p class="mt-2 line-clamp-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
                {doc.data.description}
              </p>
              <div class="mt-4 flex flex-wrap items-center gap-3 font-mono text-xs text-zinc-500">
                <time>{fmtDate(doc.data.date)}</time>
                <span>·</span>
                <span>{doc.data.author}</span>
                {doc.data.tags?.slice(0, 3).map((tag) => (
                  <span class="rounded-full border border-zinc-300 px-2 py-0.5 dark:border-zinc-700">
                    #{tag}
                  </span>
                ))}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
