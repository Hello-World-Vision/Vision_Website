---
// =============================================================================
// 入组培训文章页 src/pages/induction-training/[...slug].astro
// 渲染 src/content/induction/ 下的任意 Markdown 为带目录（TOC）的文章页：
//   /induction-training/<文件名>
// 新增文档 = 在 src/content/induction/ 下新建 .md 文件，无需改动任何代码。
// =============================================================================
import DocLayout from '../../layouts/DocLayout.astro';
import { getCollection, render } from 'astro:content';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const docs = (await getCollection('induction')).filter((e) => !e.data.draft);

  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const readingTime = remarkPluginFrontmatter?.readingTime as number | undefined;
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  author={entry.data.author}
  date={entry.data.date}
  readingTime={readingTime}
  tags={entry.data.tags}
  headings={headings}
  Content={Content}
  backHref={`${base}induction-training`}
  backLabel="返回入组培训"
/>
